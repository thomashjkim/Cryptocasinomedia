{
  "version": 2,
  "cleanUrls": false,
  "trailingSlash": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/images/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/tailwind.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/sitemaps/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/regulation/topic/:slug*/",
      "destination": "/topic/:slug*/",
      "permanent": true
    },
    {
      "source": "/press-releases/topic/:slug*/",
      "destination": "/topic/:slug*/",
      "permanent": true
    },
    {
      "source": "/crypto-casinos/topic/:slug*/",
      "destination": "/topic/:slug*/",
      "permanent": true
    },
    {
      "source": "/sportsbook/topic/:slug*/",
      "destination": "/topic/:slug*/",
      "permanent": true
    },
    {
      "source": "/payments/topic/:slug*/",
      "destination": "/topic/:slug*/",
      "permanent": true
    },
    {
      "source": "/sweepstakes/topic/:slug*/",
      "destination": "/topic/:slug*/",
      "permanent": true
    },
    {
      "source": "/guides/topic/:slug*/",
      "destination": "/topic/:slug*/",
      "permanent": true
    },
    {
      "source": "/regulation/topic/",
      "destination": "/topic/",
      "permanent": true
    },
    {
      "source": "/press-releases/topic/",
      "destination": "/topic/",
      "permanent": true
    },
    {
      "source": "/crypto-casinos/topic/",
      "destination": "/topic/",
      "permanent": true
    },
    {
      "source": "/sportsbook/topic/",
      "destination": "/topic/",
      "permanent": true
    },
    {
      "source": "/payments/topic/",
      "destination": "/topic/",
      "permanent": true
    },
    {
      "source": "/sweepstakes/topic/",
      "destination": "/topic/",
      "permanent": true
    },
    {
      "source": "/guides/topic/",
      "destination": "/topic/",
      "permanent": true
    }
  ]
}